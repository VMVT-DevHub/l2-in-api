            }
          },
          "pavadinimas": {
            "title": "Pavadinimas *",
            "type": "string",
            "maxLength": 254,
            "errorMessage": {
              "maxLength": "Pavadinimas negali būti ilgesnės nei 255 simboliai."
            }
          },
          "komercinis-lotyniskas-pavadinimas": {
            "title": "Komercinis / lotyniškas pavadinimas (jeigu taikoma)",
            "type": "string"
          },

        }
      },
      "patvirtinu-teisybe": {
        "type": "boolean",
        "title": "prašyme pateikti duomenys yra paremti dokumentais, jie patikrinti ir atitinka tikrovę, produktų sauga ir kokybė atitinka ES ir Lietuvos bei šalies importuotojos teisės aktų reikalavimus, trečiajai šaliai priėmus sprendimą grąžinti prekę, nedelsiant informuosiu VMVT skyrių, išdavusį sertifikatą ar pažymėjimą, pateikdamas išsamią informaciją ir dokumentus.",
        "const": true,
        "errorMessage": {
          "const": "Privalote patvirtinti pateiktų duomenų teisingumą, produktų atitiktį reikalavimams ir įsipareigoti informuoti VMVT apie grąžintą prekę."
        }
      },
      "sutikimas-informuotas": {
        "type": "boolean",
        "title": "Esu informuotas (-a), jog mano asmens duomenys bus tvarkomi asmens, teikiančio šį prašymą, tapatybės nustatymo ir informavimo apie prašymo nagrinėjimą tikslais.",
        "const": true,
        "errorMessage": {
          "const": "Privalote patvirtinti, kad esate informuotas (-a) apie asmens duomenų tvarkymą."
        }
      },
        "sutikimas-ar-yra-email": {
          "type": "boolean",
          "title": "Sutinku gauti informaciją apie reikalavimų pakeitimus el. paštu"
        },
        "sutikimas-email": {
          "type": "string",
          "title": "Įveskite savo el. paštą:"
        },
     
        "atsakymas": {
          "type": "object",
          "additionalProperties": false,
          "default": {},
          "properties": {
            "ats-gavimas": {
              "type": "string",
              "enum": [
                "Nacionalinę elektroninių siuntų pristatymo naudojant pašto tinklą informacinę sistemą",
                "el. paštu",
                "paštu",
                "kreipiantis asmeniškai arba per atstovą"
              ]
            }
          },
          "required": ["ats-gavimas"],
          "errorMessage": {
            "required": { "ats-gavimas": "Privalote pasirinkti, kaip gauti atsakymą" }
          }
        }
      },

       "if": {
        "properties": {
          "sutikimas-ar-yra-email": {
            "const": true

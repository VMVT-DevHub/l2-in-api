       "turiu-teise": {
        "type": "boolean",
        "title": "turiu teisę tiekti ES rinkai ir jai tiekiu šiame prašyme nurodytą maistą;",
        "const": true,
        "errorMessage": {
          "const": "Privalote patvirtinti, kad turite teisę tiekti ES rinkai ir jai tiekiate šiame prašyme nurodytą maistą."
        }
      },
      "turiu-patvirtinima": {
        "type": "boolean",
        "title": "man suteiktas maisto tvarkymo subjekto patvirtinimas / registravimas nėra sustabdytas / panaikintas;",

            "errorMessage": {
              "required": {
                "kiekis": "Prekės: neto kiekis privalomas.",
                "matas": "Prekės: neto matas privalomas"
              }
            }
          },
          "bruto-kiekis-matas": {
            "title": "Kiekis (bruto)",
            "type": "object",
            "properties": {
              "kiekis": {
                "type": "number"
              },
              "matas": {
                "type": "string",
                "enum": ["kg", "vnt", "doz"]
              }
            }
          },
          "laikymo-ir-transportavimo-salygos": {
            "title": "Laikymo ir transportavimo sąlygos *",
            "type": "string",
            "enum": ["Aplinkos", "Atvėsintas", "Užšaldytas"]
          },
          "salis": {
            "$ref": "#/definitions/salis"
          },
          "asmuo": {
            "allOf": [{ "$ref": "forms/global/defs.json#/definitions/asmuo-su-kodu" }]

{
  "type": "object",
  "title": "Prašymas išduoti eksporto sertifikatą negyvūniam maistui arba maisto sveikumo sertifikatą",
  "additionalProperties": false,
  "properties": {
    "siuntejas": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "atsakingas-asmuo": {
          "type": "object",
          "additionalProperties": true,
          "default": {},
          "properties": {
            "vardas": {
              "title": "Vardas, pavardė",
              "type": "string"
            },
            "pareigos": {
              "title": "Pareigos *",
              "type": "string",
              "maxLength": 100,
              "errorMessage": {
                "maxLength": "Pareigos negali būti ilgesnės nei 100 simbolių."
              }
            },
            "telefono-nr": {
              "title": "Telefono nr. *",
              "type": "string",
              "minLength": 1,
              "pattern": "^(\\+370|370|0)[\\s-]?\\d{8}$",
              "errorMessage": {
                "pattern": "Telefono numeris turi būti galiojantis",
                "minLength": "Telefono numeris privalomas."
              },
              "x-isPhoneOrEmail": true
            },
            "el-pastas": {
                "title": "El. paštas *",
                "type": "string",
                "format": "email",
                "maxLength": 254,
                "x-isPhoneOrEmail": true,
                "errorMessage": {
                  "format": "El. paštas turi būti galiojantis",
                  "maxLength": "El. paštas negali būti ilgesnis nei 254 simboliai."
                }
            },
            "ja":{
              "title":"Juridinio asmens kodas",
              "type":["string", "null"],
              "readOnly": true
            },
            "aob":{
              "title":"AOB kodas",
              "type":"string",
              "readOnly": true
        }
          },
          "required": ["vardas", "pareigos"],
            "errorMessage": {
              "required": {
                "vardas": "Vardas ir pavardė yra privalomi.",
                "pareigos": "Pareigos yra privalomos."
              }
            }
        },
        "ja-duomenys": {
          "type": "object",
          "additionalProperties": true,
          "default": {},
          "properties": {
            "ja-pavadinimas": {
              "type": "string",
              "title": "Juridinio asmens pavadinimas",
              "readOnly": true
            },
            "pusris-nr": {
              "type": "string",
              "title": "Patvirtinimo/registravimo (PŪSRIS) numeris"
            },
            "ja-gyv": {
              "type": "object",
              "properties": {
                "gyvId": { "type": "number" },
                "gyvName": { "type": "string" },
                "adrId": { "type": "number" },
                "adrName": { "type": "string" }
              }
            },
            "ja-moketojo-kodas": {
              "type": "string",
              "title": "Juridinio asmens kodas",
              "pattern": "^\\d{9}$",
              "errorMessage": {
                "pattern": "Juridinio asmens kodas turi būti galiojantis"
              }
            }
          },
          "required": ["pusris-nr"],
            "errorMessage": {
              "required": {
                "pusris-nr": "Patvirtinimo/registravimo (PŪSRIS) numeris yra privalomas."
              }
            }
        },
        "fa-duomenys": {
          "type": "object",
          "additionalProperties": false,
          "default": {},
          "properties": {
            "vardas": {
              "type": "string",
              "title": "Vardas",
              "readOnly": true
            },
            "pavarde": {
              "type": "string",
              "title": "Pavardė",
              "readOnly": true
            },
            "fa-moketojo-kodas": {
              "type": "string",
              "title": "Mokesčių mokėtojo identifikacinis kodas",
              "pattern": "^[0-9]{11}$",
              "errorMessage": {
                "pattern": "Mokesčių mokėtojo identifikacinis kodas turi būti galiojantis"
              }
            }
          }
        }
      },
      "required": ["atsakingas-asmuo"],
      "allOf": [
        {
          "if": {
            "type": "object",
            "properties": {
              "atsakingas-asmuo": {
                "type": "object",
                "properties": {
                  "ja": { "minLength": 1, "type": "string" }
                },
                "required": ["ja"]
              }
            }
          },
          "then": {
            "type": "object",
            "properties": {
              "ja-duomenys": {
                "type": "object",
                "required": ["ja-pavadinimas", "ja-moketojo-kodas"],
                "errorMessage": {
                  "required": {
                    "ja-pavadinimas": "Juridinio asmens pavadinimas yra privalomas.",
                    "ja-gyvenviete": "Juridinio asmens gyvenvietė yra privaloma.",
                    "ja-adresas": "Juridinio asmens adresas yra privalomas.",
                    "ja-moketojo-kodas": "Juridinio asmens moketojo kodas yra privalomas."
                  }
                }
              }
            }
          },
          "else": {
            "type": "object",
            "properties": {
              "fa-duomenys": {
                "type": "object",
                "required": ["vardas", "pavarde", "fa-moketojo-kodas"],
                "errorMessage": {
                  "required": {
                    "vardas": "Fizinio asmens vardas yra privalomas.",
                    "pavarde": "Fizinio asmens pavardė yra privaloma.",
                    "fa-moketojo-kodas": "Fizinio asmens mokėtojo kodas yra privalomas."
                  }
                }
              }
            }
          }
        }
      ]
    },
     "marsrutas": {
      "type": "object",
      "title": "Kelionės maršrutas",
      "additionalProperties": false,
      "default": {},
      "required": ["eksportuojanti-salis", "importuojanti-salis"],
      "errorMessage": {
        "required": {
          "eksportuojanti-salis": "Eksportuojanti šalis turi būti nurodyta.",
          "importuojanti-salis": "Importuojanti šalis turi būti nurodyta."
        }
      },
      "properties": {
        "eksportuojanti-salis": {
          "type": "object",
          "additionalProperties": false,
          "default": {},
          "required": ["salis"],
          "errorMessage": {
            "required": {
              "salis": "Eksportuojanti šalis yra privaloma."
            }
          },
          "properties": {
            "salis": {
              "title": "Eksportuojanti šalis",
              "$ref": "#/definitions/salis",
              "default": "LTU"
            }
           
          }
        },
        "tranzitines-salys": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["salis"],
            "errorMessage": {
              "required": {
                "salis": "Tranzitinė šalis yra privaloma."
              }
            },
            "properties": {
              "salis": {
                "title": "Tranzitinė šalis",
                "$ref": "#/definitions/salis"
              }
            }
          }
        },
        "importuojanti-salis": {
          "type": "object",
          "additionalProperties": false,
          "required": ["salis"],
          "errorMessage": {
            "required": {
              "salis": "Importuojanti šalis yra privaloma."
            }
          },
          "properties": {
            "salis": {
              "title": "Importuojanti šalis",
              "$ref": "#/definitions/salis"
            }
          }
        }
      }
    },
    "transportas": {
      "type": "object",
      "default": {},
      "title": "Transporto priemone",
      "additionalProperties": false,
      "properties": {
        "transporto-priemones": {
          "type": "array",
          "default": [{}],
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "rusis-id": {
                "title": "Transporto priemonės rūšis *",
                "type": "string",
                "fetchEnumFrom": "options.transportTypes.findIds"
              },
              "rusis": {
                "title": "Transporto priemonės rūšis",
                "type": "string"
              },
              "rusis-kita": {
                "title": "Nurodykite transporto rūšį",
                "type": "string"
              },
              "numeris": {
                "title": "Transporto priemonės Nr. *",
                "type": "string"
              }
            },
            "required": ["rusis-id", "numeris"],
            "errorMessage": {
              "required": {
                "rusis-id": "Transporto priemonės rūšis yra privaloma.",
                "numeris": "Transporto priemonės numeris yra privalomas."
              }
            }
          }
        }
      },
      "required": ["transporto-priemones"],
      "errorMessage": {
        "required": {
          "transporto-priemones": "Transporto premonės informacija yra privaloma."
        }
      }
    },
     "pakrovimo-vieta": {
      "type": "object",
      "additionalProperties": false,
      "default": {},
      "properties": {
        "asmuo": {
          "$ref": "forms/global/defs.json#/definitions/asmuo-su-kodu"
        },
        "ar-sutampa-adresas": {
          "title": "Pakrovimo vietos (veiklavietės) pavadinimas ir adresas sutampa su Siuntėjo pavadinimu ir adresu",
          "type": "boolean",
          "default": false,
          "x-isJACopy": true
        },
        "ja-gyv": {
          "type": "object",
          "properties": {
            "gyvId": { "type": "number" },
            "gyvName": { "type": "string" },
            "adrId": { "type": "number" },
            "adrName": { "type": "string" }
          }
        },
        "patvirtinimo-iregistravimo-nr":{
          "title": "Patvirtinimo ar įregistravimo numeris",
          "type": "string"
        },
        "isvykimas":{
          "title": "Numatoma krovinio išvykimo data",
          "type": "string",
          "format": "date"
        }
      },
      "required": [
        "patvirtinimo-iregistravimo-nr",
        "asmuo",
        "isvykimas"
      ],
      "errorMessage": {
        "required": {
          "patvirtinimo-iregistravimo-nr": "Patvirtinimo ar įregistravimo numeris privalomas.",
          "asmuo": "Asmuo privalomas.",
          "isvykimas": "Numatoma krovinio išvykimo data privaloma"
        }
      }
    },
    "prekes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": true,
        "default": {},
        "properties": {
          "kpn-kodas": {
            "title": "KPN kodas *",

              "enum": "Pakuotės tipas privalomas."
            }
          },
          "pakuotes-tipas-kita": {
            "title": "Įveskite kitą pakuotės tipą *",
            "type": "string"
          },
          "pakuociu-skaicius": {
            "title": "Pakuočių skaičius (vnt.) *",
            "type": "number"
          },
          "excel-dokumentas": {
            "$ref": "forms/global/defs.json#/definitions/dokumentas"
          },
          "neto-kiekis-matas": {

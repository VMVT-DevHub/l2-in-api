{
  "type": "Categorization",
  "options": {
    "display": "form",
    "labels": {
      "siuntejas": "Siuntėjas",
      "marsrutas": "Maršrutas",
      "siunta": "Siunta",
      "prekes": "Prekės",
      "pakrovimo-vieta": "Pakrovimo vieta",
      "zaliavos": "Žaliavos",
      "gavejas": "Gavėjas",
      "dokumentai": "Dokumentai"
    }
  },

  "elements": [
    {
      "type": "Category",
      "label": "Siuntėjas",
      "elements": [
        {
          "type": "Group",
          "label": "Siuntėjas",
          "elements": [
            {
              "type": "HorizontalLayout",
              "options": {
                "columns": 3
              },
              "elements": [
                {
                  "type": "Control",
                  "scope": "#/properties/siuntejas/properties/ja-duomenys/properties/ja-pavadinimas",
                  "options": {
                    "display": "authField",
                    "key": "companyName"
                  }
                },
                {
                  "type": "Control",
                  "scope": "#/properties/siuntejas/properties/ja-duomenys/properties/ja-moketojo-kodas",
                  "options": {
                    "display": "authField",
                    "key": "activeOrgCode"
                  }
                },
                {
                  "type": "Control",
                  "scope": "#/properties/siuntejas/properties/ja-duomenys/properties/tvarkymo-nr"
                }
              ]
            },
            {
              "type": "Control",
              "scope": "#/properties/siuntejas/properties/ja-duomenys/properties/ja-gyv",
              "options": {
                "display": "addressSelect"
              },
              "rule": {
                "effect": "DISABLE",
                "condition": {
                  "scope": "#/properties/siuntejas/properties/atsakingas-asmuo/properties/aob",
                  "schema": { "type": "string" },
                  "failWhenUndefined": true
                }
              }
            }
          ],
          "rule": {
            "effect": "SHOW",
            "condition": {
              "scope": "#/properties/siuntejas/properties/atsakingas-asmuo/properties/ja",
              "schema": { "type": "string" },
              "failWhenUndefined": true
            }
          }
        },
        {
          "type": "Group",
          "label": "Siuntėjas",
          "elements": [
            {
              "type": "HorizontalLayout",
              "options": {
                "columns": 2
              },
              "elements": [
                {
                  "type": "Control",
                  "scope": "#/properties/siuntejas/properties/fa-duomenys/properties/vardas",
                  "options": {
                    "display": "authField",
                    "key": "firstName"
                  }
                },
                {
                  "type": "Control",
                  "scope": "#/properties/siuntejas/properties/fa-duomenys/properties/pavarde",
                  "options": {
                    "display": "authField",
                    "key": "lastName"
                  }
                },
                {
                  "type": "Control",
                  "scope": "#/properties/siuntejas/properties/fa-duomenys/properties/fa-moketojo-kodas",
                  "options": {
                    "display": "authField",
                    "key": "ak"
                  }
                },
                {
                  "type": "Control",
                  "scope": "#/properties/siuntejas/properties/ja-duomenys/properties/pusris-nr"
                }
              ]
            }
          ],
          "rule": {
            "effect": "HIDE",
            "condition": {
              "scope": "#/properties/siuntejas/properties/atsakingas-asmuo/properties/ja",
              "schema": { "type": "string" },
              "failWhenUndefined": true
            }
          }
        },
        {
          "type": "Group",
          "label": "Atsakingas asmuo",
          "elements": [
            {
              "type": "HorizontalLayout",
              "elements": [
                {
                  "type": "Control",
                  "scope": "#/properties/siuntejas/properties/atsakingas-asmuo/properties/ja",
                  "options": {
                    "display": "authField",
                    "key": "activeOrgCode",
                    "hidden": true
                  }
                },
                {
                  "type": "Control",
                  "scope": "#/properties/siuntejas/properties/atsakingas-asmuo/properties/aob",
                  "options": {
                    "display": "authField",
                    "key": "aob",
                    "hidden": true
                  }
                }
              ]
            },
            {
              "type": "HorizontalLayout",
              "elements": [
                {
                  "type": "Control",
                  "scope": "#/properties/siuntejas/properties/atsakingas-asmuo/properties/vardas"
                },
                {
                  "type": "Control",
                  "scope": "#/properties/siuntejas/properties/atsakingas-asmuo/properties/pareigos"
                }
              ]
            },
            {
              "type": "HorizontalLayout",
              "elements": [
                {
                  "type": "Control",
                  "scope": "#/properties/siuntejas/properties/atsakingas-asmuo/properties/telefono-nr",
                  "options": {
                    "placeholder": "+37060000000 arba 06000000",
                    "display": "authField",
                    "key": "phone"
                  }
                },
                {
                  "type": "Control",
                  "scope": "#/properties/siuntejas/properties/atsakingas-asmuo/properties/el-pastas",
                  "format": "email",
                  "options": {
                    "placeholder": "vardas.pavarde@domenas.lt",
                    "display": "authField",
                    "key": "email"
                  }
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "type": "Category",
      "label": "Prekės",
      "elements": [
        {
          "type": "Group",
          "elements": [
            {
              "type": "Control",
              "scope": "#/properties/prekes",
              "options": {
                "display": "modal",
                "addLabel": "Pridėti prekę",
                "card": {
                  "title": { "scope": "#/properties/komercinis-lotyniskas-pavadinimas" },
                  "code": { "scope": "#/properties/kpn-kodas" },
                  "top": [
                    {
